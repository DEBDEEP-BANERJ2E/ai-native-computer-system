digraph "Toffoli" {
label="Toffoli";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="io_r", color="black", fontcolor="black"];
n3 [ shape=octagon, label="io_q", color="black", fontcolor="black"];
n4 [ shape=octagon, label="io_p", color="black", fontcolor="black"];
n5 [ shape=octagon, label="io_c", color="black", fontcolor="black"];
n6 [ shape=octagon, label="io_b", color="black", fontcolor="black"];
n7 [ shape=octagon, label="io_a", color="black", fontcolor="black"];
n8 [ shape=octagon, label="reset", color="black", fontcolor="black"];
n9 [ shape=octagon, label="clock", color="black", fontcolor="black"];
c13 [ shape=record, label="{{<p10> A|<p11> B}|$2\n$xor|{<p12> Y}}",  ];
c14 [ shape=record, label="{{<p10> A|<p11> B}|$1\n$and|{<p12> Y}}",  ];
x0 [shape=point, ];
x1 [shape=point, ];
c14:p12:e -> c13:p11:w [color="black", fontcolor="black", label=""];
c13:p12:e -> n2:w [color="black", fontcolor="black", label=""];
x0:e -> n3:w [color="black", fontcolor="black", label=""];
x1:e -> n4:w [color="black", fontcolor="black", label=""];
n5:e -> c13:p10:w [color="black", fontcolor="black", label=""];
n6:e -> c14:p11:w [color="black", fontcolor="black", label=""];
n6:e -> x0:w [color="black", fontcolor="black", label=""];
n7:e -> c14:p10:w [color="black", fontcolor="black", label=""];
n7:e -> x1:w [color="black", fontcolor="black", label=""];
}
